# Build outputs. The tracked binaries/ payload is game data (Amiga BGM_DAT and
# friends); these are produced by building the Atari target and re-dirty the
# tree after every build.
/binaries/*.o
/binaries/atari/*.o
/binaries/atari/*.lod
/binaries/atari/*.tos
/binaries/amiga/sz2
/binaries/amiga/sz2_dbg
/binaries/amiga/sz2_profile
/binaries/amiga/vram_bench
/binaries/amiga/hardware_test/
/binaries/amiga/hardware_test.zip
